{
  "name": "tak-portal",
  "version": "2.0.43",
  "beta-version": "2.0.44",
  "cloudtak-marketplace-version": "1.0.12",
  "description": "",
  "main": "server.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run build:map && npm run typecheck && npm test",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\"",
    "audit:icons": "node scripts/audit-map-icons.js",
    "vendor:icons": "node --use-system-ca scripts/vendor-cloudtak-icons.js",
    "generate:map": "node scripts/generate-map-app.mjs",
    "build:map": "node scripts/generate-map-app.mjs && node scripts/build-map.mjs",
    "watch:map": "node scripts/generate-map-app.mjs && node scripts/build-map.mjs --watch",
    "prestart": "node scripts/ensure-map-built.mjs",
    "start": "node --use-system-ca server.js",
    "worker": "node --use-system-ca worker.js"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "type": "commonjs",
  "overrides": {
    "whatwg-url": "^14.2.0",
    "undici": "$undici",
    "node-forge": "^1.4.3",
    "proxy-addr": "^2.0.8",
    "follow-redirects": "^1.16.1",
    "fast-uri": "^3.1.9",
    "brace-expansion": "^5.0.12",
    "source-map-js": "^1.2.2",
    "minimatch": "^11.0.1",
    "glob": "^14.0.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@tak-ps/node-cot": "^14.51.0",
    "@tak-ps/node-tak": "^12.37.0",
    "@tmcw/togeojson": "^7.1.4",
    "@xmldom/xmldom": "^0.9.12",
    "archiver": "^8.0.0",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "geotiff": "^3.0.5",
    "geotiff-geokeys-to-proj4": "^2026.10.9",
    "jimp": "1.6.1",
    "maplibre-gl": "6.19.0",
    "marked": "^18.0.9",
    "milsymbol": "^3.0.5",
    "multer": "^2.5.0",
