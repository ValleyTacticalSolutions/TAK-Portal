    "nodemailer": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "proj4": "^2.23.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.2",
