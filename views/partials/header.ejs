<%
  const _portalName =
    typeof portalTitle !== "undefined" && portalTitle
      ? String(portalTitle).trim()
      : "TAK Portal";
  const _pageName =
    typeof pageTitle !== "undefined" && pageTitle ? String(pageTitle).trim() : "";
  const _customName = String(
    (typeof settings !== "undefined" && settings && settings.SERVER_NAME) || ""
  ).trim();
  let _docTitle = _pageName || _portalName;
  if (_customName && _pageName) {
    const alreadyBranded =
      _pageName === _portalName ||
      _pageName.toLowerCase().startsWith(_portalName.toLowerCase() + " ") ||
      _pageName.toLowerCase().startsWith(_portalName.toLowerCase() + " -") ||
      _pageName.toUpperCase().startsWith(_customName.toUpperCase() + " ");
    _docTitle = alreadyBranded ? _pageName : _portalName + " - " + _pageName;
  } else if (!_pageName) {
    _docTitle = _portalName;
  }
%>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1<%= typeof bodyExtraClass !== 'undefined' && String(bodyExtraClass).indexOf('map-page') !== -1 ? ', viewport-fit=cover' : '' %>" />
    <title><%= _docTitle %></title>
    <link rel="stylesheet" href="/styles.css" />
    <% if (typeof extraStylesheets !== "undefined" && extraStylesheets && extraStylesheets.length) { %>
      <% extraStylesheets.forEach(function (href) { %>
    <link rel="stylesheet" href="<%= href %>" />
      <% }); %>
    <% } %>
    <% if (typeof extraHead !== "undefined" && extraHead) { %>
      <%- extraHead %>
    <% } %>
    <script>
      (function () {
        var isMapPage = <%= typeof bodyExtraClass !== "undefined" && String(bodyExtraClass).indexOf("map-page") !== -1 ? "true" : "false" %>;
        function clearMapLayoutLeak() {
          if (isMapPage) return;
          var root = document.documentElement;
          root.classList.remove("map-page", "map-sidebar-collapsed");
          if (document.body) {
            document.body.classList.remove("map-page", "sidebar-open");
          }
        }
        if (isMapPage) {
          document.documentElement.classList.add("map-page");
          try {
            if (
              window.matchMedia("(min-width: 991px)").matches &&
              localStorage.getItem("tak-portal-map-site-sidebar") === "collapsed"
            ) {
              document.documentElement.classList.add("map-sidebar-collapsed");
            }
          } catch (e) {}
        } else {
          clearMapLayoutLeak();
        }
        window.addEventListener("pageshow", clearMapLayoutLeak);
      })();
    </script>

    <% if (brandLogoUrl) { %>
      <link rel="icon" href="<%= brandLogoUrl %>" type="image/png" />
      <link rel="shortcut icon" href="<%= brandLogoUrl %>" type="image/png" />
    <% } %>
  </head>
  <body
    class="theme-<%= brandTheme || 'dark' %><%= typeof bodyExtraClass !== 'undefined' && bodyExtraClass ? ' ' + bodyExtraClass : '' %>"
    <% if (typeof mapStorageUserKey !== "undefined" && mapStorageUserKey) { %>data-map-user="<%= mapStorageUserKey %>"<% } %>
    <% if (primaryButtonColor || siteFontFamily) { %>
      style="<% if (primaryButtonColor) { %>--btn:<%= primaryButtonColor %>;<% } %><% if (siteFontFamily) { %>--site-font:<%= siteFontFamily %>;<% } %>"
    <% } %>
  >

    <%- include("theme-toggle") %>

		<!-- Mobile menu button (shows under 990px via CSS) -->
		<button
		  class="sidebarToggle"
		  id="sidebarToggle"
		  type="button"
		  aria-controls="sidebar"
		  aria-expanded="false"
		  aria-label="Open menu"
		  title="Menu"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M4 7h16M4 12h16M4 17h16" />
			</svg>
		</button>

		<!-- Overlay shown when sidebar is open on small screens -->
		<div class="sidebarOverlay" id="sidebarOverlay" aria-hidden="true"></div>

		<div id="stackHealthLock" class="stackHealthLock" hidden role="alertdialog" aria-modal="true" aria-labelledby="stackHealthLockTitle" aria-describedby="stackHealthLockMessage">
			<div class="stackHealthLockBox">
				<div class="stackHealthLockLogo">
					<% if (typeof brandLogoUrl !== "undefined" && brandLogoUrl) { %>
						<img src="<%= brandLogoUrl %>" alt="<%= typeof portalTitle !== "undefined" && portalTitle ? portalTitle : "TAK Portal" %>" />
					<% } else { %>
						<div class="stackHealthLockLogoFallback" aria-hidden="true">TAK<span>PORTAL</span></div>
					<% } %>
				</div>
				<h1 id="stackHealthLockTitle"><%= typeof portalTitle !== "undefined" && portalTitle ? portalTitle : "TAK Portal" %> Is Unavailable</h1>
				<p id="stackHealthLockMessage">TAK Portal is not responding properly.<br>Please refresh the page or try again later.</p>
				<p class="stackHealthLockHint">For ongoing issues, please contact your TAK Administrator</p>
			</div>
		</div>

		<div class="app">

      <script>
        (function () {
          function isOverlayOpen(el) {
            if (!el) return false;
            const cs = window.getComputedStyle(el);
            if (!cs) return false;
            return cs.display !== "none" && cs.visibility !== "hidden";
          }

          function syncModalOpenClass() {
            const overlays = document.querySelectorAll(".modalOverlay");
            let anyOpen = false;
            overlays.forEach((el) => {
              if (!anyOpen && isOverlayOpen(el)) anyOpen = true;
            });
            document.body.classList.toggle("modal-open", anyOpen);
          }

          function initModalOpenWatcher() {
            syncModalOpenClass();
            const mo = new MutationObserver(syncModalOpenClass);
            mo.observe(document.documentElement, {
              attributes: true,
              attributeFilter: ["style", "class"],
              subtree: true,
              childList: true,
            });
            window.addEventListener("resize", syncModalOpenClass);
          }

          // Close-on-backdrop only if the press started on the overlay itself.
          // Selecting text inside a modal and releasing outside must not dismiss it.
          var overlayMouseDownTarget = null;
          function isModalOverlayEl(el) {
            return !!(el && el.classList && el.classList.contains("modalOverlay"));
          }
          document.addEventListener("pointerdown", function (e) {
            overlayMouseDownTarget = isModalOverlayEl(e.target) ? e.target : null;
          }, true);
          document.addEventListener("mousedown", function (e) {
            overlayMouseDownTarget = isModalOverlayEl(e.target) ? e.target : null;
          }, true);
          document.addEventListener("click", function (e) {
            if (!isModalOverlayEl(e.target)) return;
            if (overlayMouseDownTarget !== e.target) {
              e.stopImmediatePropagation();
            }
          }, true);

          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initModalOpenWatcher);
          } else {
            initModalOpenWatcher();
          }
        })();
      </script>

			<script src="/sidebar.js" defer=""></script>
      <script src="/theme-toggle.js" defer></script>
      <script src="/stack-health-banner.js" defer></script>
		