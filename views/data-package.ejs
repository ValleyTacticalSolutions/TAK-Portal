<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main data-packages-page">
  <div class="data-packages-hero">
    <%- include("partials/scoped-admin-page-title", {
      globalTitle: "Data Package Manager",
      scopedSuffix: "Data Package Manager",
      singleFallbackTitle: "Agency Data Package Manager"
    }) %>
  </div>

  <div id="statusBanner" class="card data-packages-status" style="display:none;" role="status"></div>

  <div class="card createFormCard">
    <h2>Upload Data Package</h2>
    <div class="createForm">
      <div class="data-packages-create-top" style="grid-column: 1 / -1;">
        <label>Title
          <input type="text" id="createPackageTitle" autocomplete="off" placeholder="e.g. County Map Pack" style="width: 100%; box-sizing: border-box;" />
        </label>
        <label>Expiration Date (Optional)
          <input type="datetime-local" id="createPackageExpiration" style="width: 100%; box-sizing: border-box;" />
        </label>
        <div class="data-packages-upload-block">
          <label class="data-packages-upload-label" for="uploadFile">Choose File</label>
          <div class="data-packages-upload-inline">
            <input
              type="file"
              id="uploadFile"
              class="data-packages-upload-input"
              accept=".zip,application/zip,application/x-zip-compressed"
            />
          </div>
        </div>
      </div>
      <div style="grid-column: 1 / -1;">
        <label>Assigned Groups / Channels
          <div class="groupFilterRow">
            <input id="createGroupFilter" placeholder="Search groups..." autocomplete="off" />
            <div class="groupFilterActions">
              <button class="btn" id="createSelectAllGroupsBtn" type="button">Select All</button>
              <button class="btn" id="createClearAllGroupsBtn" type="button">Clear All</button>
            </div>
          </div>
          <div id="createGroupsBox" class="groupsBox">
            <div id="createGroupsInner" class="groupsInner"></div>
          </div>
        </label>
      </div>
      <div class="createActionsRow row" style="grid-column: 1 / -1; justify-content: flex-end; align-items: center; gap: 10px; flex-wrap: wrap;">
        <span id="uploadMsg" class="msg" style="margin-right: auto;"></span>
        <button type="button" class="btn success data-packages-upload-btn" id="btnUploadPackage">Upload Data Package</button>
      </div>
    </div>
  </div>

  <div class="card" style="margin-top:1.25rem;">
    <h2 style="margin-top:0;">Existing Data Packages</h2>
    <div class="row" style="flex-wrap:wrap; align-items:flex-end; gap:12px;">
      <div id="bulkActionsWrap" style="min-width:280px; display:none;">
        <div class="row" style="gap:8px; align-items:center; margin-top:2px;">
          <select id="bulkActionSelect">
            <option value="">Choose action...</option>
            <option value="download">Download Selected</option>
            <option value="archive">Archive Selected</option>
            <option value="delete">Delete Selected</option>
          </select>
          <button type="button" class="btn" id="bulkActionApplyBtn">Apply</button>
        </div>
      </div>
      <div style="flex:1 1 100%; width:100%;">
        <input type="search" id="packageFilter" placeholder="Filter by filename/creator..." autocomplete="off" />
      </div>
    </div>
    <div id="packagesMsg" class="msg" style="margin:12px 0 0 0;"></div>
    <div class="data-packages-table-scroll listCardTableWrap">
      <table class="table data-packages-table listCardTable">
        <thead>
          <tr>
            <th style="width:42px;">
              <input type="checkbox" id="activeSelectAllChk" aria-label="Select all active packages" />
            </th>
            <th>Title</th>
            <th>Channels</th>
            <th>Size</th>
            <th class="data-packages-col-creator">Creator</th>
            <th class="data-packages-col-expiration">Expiration</th>
            <th class="data-packages-col-updated">Last Updated</th>
            <th style="min-width:220px;">Actions</th>
          </tr>
        </thead>
        <tbody id="packagesTbody"></tbody>
      </table>
    </div>
  </div>

  <details class="card" style="margin-top:1.25rem;">
    <summary style="cursor:pointer;font-weight:600;user-select:none;">
      Archived Data Packages <span id="archivedCountWrap">(<span id="archivedCount">0</span>)</span>
    </summary>
    <div style="margin-top:12px;">
      <div id="archivedPackagesMsg" class="msg" style="margin-left:0;"></div>
      <div class="data-packages-table-scroll listCardTableWrap">
        <table class="table data-packages-table listCardTable">
          <thead>
            <tr>
            <th style="width:42px;">
              <input type="checkbox" id="archivedSelectAllChk" aria-label="Select all archived packages" />
            </th>
              <th>Title</th>
              <th>Channels</th>
              <th>Size</th>
              <th class="data-packages-col-creator">Creator</th>
              <th class="data-packages-col-expiration">Expiration</th>
              <th class="data-packages-col-updated">Last Updated</th>
              <th style="min-width:220px;">Actions</th>
            </tr>
          </thead>
          <tbody id="archivedPackagesTbody"></tbody>
        </table>
      </div>
    </div>
  </details>
</main>

<!-- Edit package -->
<div class="modalOverlay" id="packageModal" style="display: none;">
  <div class="modal data-packages-edit-modal" role="dialog" aria-modal="true" aria-labelledby="packageModalTitle">
    <div class="modalHeader">
      <h2 id="packageModalTitle" style="margin: 0;">Edit Data Package</h2>
      <button type="button" class="btn" id="packageModalClose">Close</button>
    </div>
    <div class="modalBody data-packages-edit-body">
      <div id="packageModalMsg" class="msg" style="margin-bottom: 12px;"></div>
      <div class="data-packages-edit-top">
        <label class="data-packages-edit-field">
          <span class="data-packages-edit-label">Title</span>
          <input type="text" id="pkgTitle" autocomplete="off" placeholder="Package title" />
        </label>
        <label class="data-packages-edit-field">
          <span class="data-packages-edit-label">Expiration Date <span class="muted">(Optional)</span></span>
          <input type="datetime-local" id="pkgExpiration" />
        </label>
      </div>
      <div class="data-packages-edit-groups">
        <div class="data-packages-edit-groups-head">
          <span class="data-packages-edit-label">Assigned Groups / Channels</span>
          <span class="muted data-packages-edit-groups-summary" id="editGroupsSummary"></span>
        </div>
        <div class="groupFilterRow data-packages-edit-filter">
          <input id="editGroupsSearch" placeholder="Search groups..." autocomplete="off" />
          <div class="groupFilterActions">
            <button class="btn" id="editGroupsSelectAll" type="button">Select All</button>
            <button class="btn" id="editGroupsClear" type="button">Clear All</button>
          </div>
        </div>
        <div id="editGroupsBox" class="groupsBox data-packages-edit-groups-box">
          <div id="editGroupsInner" class="groupsInner"></div>
        </div>
      </div>
      <div class="data-packages-edit-actions">
        <button type="button" class="btn success" id="pkgBtnSave">Save Data Package</button>
      </div>
    </div>
  </div>
</div>

<style>
  .data-packages-page.main { min-width: 0; max-width: 100%; box-sizing: border-box; }
  .data-packages-page .card, .data-packages-page .data-packages-table-scroll { min-width: 0; max-width: 100%; box-sizing: border-box; }
  .data-packages-status.msg { margin-left: 0; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--line); }
  .data-packages-status.bad { border-color: rgba(255,80,80,.45); background: rgba(255,80,80,.08); }
  .data-packages-page .data-packages-create-top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 12px;
    align-items: end;
  }
  .data-packages-page .data-packages-create-top > label,
  .data-packages-page .data-packages-create-top > .data-packages-upload-block {
    min-width: 0;
  }
  @media (max-width: 900px) {
    .data-packages-page .data-packages-create-top {
      grid-template-columns: 1fr;
      align-items: stretch;
    }
  }
  .data-packages-page .data-packages-upload-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    width: 100%;
  }
  .data-packages-page .data-packages-upload-label {
    display: block;
    font-size: 13px;
    color: var(--text);
  }
  .data-packages-page .data-packages-upload-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .data-packages-page .data-packages-upload-input {
    flex: 1 1 260px;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    margin: 0;
  }
  .data-packages-page .data-packages-upload-btn {
    flex: 0 0 auto;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
  }
  @media (min-width: 640px) {
    .data-packages-page .data-packages-upload-btn { width: auto; }
  }
  .data-packages-page .data-packages-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: 12px; width: 100%; }
  .data-packages-page .data-packages-table { width: 100%; }
  .data-packages-page .data-packages-actions-cell .cardActionsRow {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .data-packages-page .data-packages-actions-cell .cardActionsRow .btn {
    width: auto;
    margin: 0;
    white-space: nowrap;
    word-break: normal;
    overflow-wrap: normal;
  }
  .data-packages-page #packageFilter{
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: block;
  }
  .data-packages-page .groupsInner {
    column-width: 280px;
    column-gap: 14px;
    column-count: 4;
  }
  .data-packages-channel-item {
    line-height: 1.35;
  }
  .data-packages-channel-item + .data-packages-channel-item {
    margin-top: 2px;
  }
  #packageModal.modalOverlay {
    align-items: flex-start;
    justify-content: center;
    padding: max(18px, 3vh) 18px 28px;
    overflow: auto;
  }
  #packageModal .data-packages-edit-modal {
    width: min(1100px, 96vw);
    max-height: min(92vh, 980px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
  }
  #packageModal .data-packages-edit-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding: 18px 20px 20px;
  }
  #packageModal .data-packages-edit-top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(220px, 0.9fr);
    gap: 14px 18px;
    align-items: end;
  }
  #packageModal .data-packages-edit-field {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
  }
  #packageModal .data-packages-edit-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.01em;
  }
  #packageModal .data-packages-edit-field input {
    width: 100%;
    box-sizing: border-box;
    margin: 0;
  }
  #packageModal .data-packages-edit-groups {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
    flex: 1 1 auto;
  }
  #packageModal .data-packages-edit-groups-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  #packageModal .data-packages-edit-groups-summary {
    font-size: 13px;
  }
  #packageModal .data-packages-edit-filter {
    margin: 0;
  }
  #packageModal .data-packages-edit-groups-box {
    flex: 1 1 auto;
    min-height: 280px;
    max-height: min(48vh, 520px);
    overflow: auto;
  }
  #packageModal .data-packages-edit-groups-box .groupsInner {
    column-count: 3;
    column-width: 220px;
  }
  #packageModal .data-packages-edit-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 4px;
    border-top: 1px solid var(--line);
    margin-top: 2px;
  }
  @media (max-width: 900px) {
    #packageModal .data-packages-edit-modal {
      width: min(960px, 96vw);
    }
    #packageModal .data-packages-edit-groups-box .groupsInner {
      column-count: 2;
      column-width: 180px;
    }
  }
  @media (max-width: 640px) {
    #packageModal .data-packages-edit-top {
      grid-template-columns: 1fr;
    }
    #packageModal .data-packages-edit-groups-box {
      min-height: 220px;
      max-height: min(42vh, 360px);
    }
    #packageModal .data-packages-edit-groups-box .groupsInner {
      column-count: 1;
      column-width: auto;
    }
  }

  @media (max-width: 990px) {
    .data-packages-page .groupsInner {
      column-count: 2;
      column-width: 160px;
    }
    .data-packages-page .listCardTableWrap,
    .data-packages-page .data-packages-table-scroll {
      overflow-x: hidden;
    }
    .data-packages-table.listCardTable {
      width: 100%;
      min-width: 0 !important;
      border-collapse: separate;
      border-spacing: 0 12px;
    }
    .data-packages-table.listCardTable thead { display: none; }
    .data-packages-table.listCardTable tbody {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .data-packages-table.listCardTable tbody tr {
      display: grid;
      grid-template-columns: auto 1fr 1fr;
      grid-template-areas:
        "check title title"
        "channels channels channels"
        "size creator creator"
        "expiration updated updated"
        "actions actions actions";
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--panel);
      overflow: hidden;
    }
    .data-packages-table .pkgCheckCell { grid-area: check; }
    .data-packages-table .cardTitleCell { grid-area: title; }
    .data-packages-table .pkgChannelsCell { grid-area: channels; }
    .data-packages-table .pkgSizeCell { grid-area: size; }
    .data-packages-table .data-packages-col-creator { grid-area: creator; }
    .data-packages-table .data-packages-col-expiration { grid-area: expiration; }
    .data-packages-table .data-packages-col-updated { grid-area: updated; }
    .data-packages-table .cardActionsCell { grid-area: actions; }
    .data-packages-table.listCardTable tbody tr.emptyStateRow {
      display: block;
      border: none;
      background: transparent;
    }
    .data-packages-table.listCardTable tbody td {
      display: block;
      border-top: none;
      padding: 8px 12px;
      word-break: normal;
      overflow-wrap: anywhere;
      min-width: 0 !important;
      max-width: none !important;
      white-space: normal;
    }
    .data-packages-table.listCardTable tbody td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--muted);
      margin-bottom: 4px;
    }
    .data-packages-table .cardTitleCell::before,
    .data-packages-table .cardActionsCell::before,
    .data-packages-table .pkgCheckCell::before {
      display: none;
    }
    .data-packages-table .cardTitleCell { padding-top: 12px; padding-bottom: 4px; }
    .data-packages-table .cardTitleText { font-weight: 600; font-size: 15px; line-height: 1.3; word-break: break-word; }
    .data-packages-table .pkgCheckCell { padding-top: 14px; }
    .data-packages-table .cardActionsCell { padding-top: 10px; padding-bottom: 12px; }
    .data-packages-table .cardActionsRow {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      width: 100%;
    }
    .data-packages-table .cardActionsRow .btn {
      width: 100% !important;
      max-width: 100%;
      min-width: 0;
      margin: 0;
      white-space: nowrap;
      box-sizing: border-box;
      text-align: center;
    }
  }
  @media (max-width: 640px) {
    .data-packages-page .groupsInner {
      column-count: 1;
    }
  }
</style>

<script>
(function () {
  var API = "/api/data-packages";
  var ACTIVE_KEYWORD = "missionpackage";
  var ARCHIVED_KEYWORD = "ARCHIVED_MISSION";
  var DATA_SYNC_KIND = "data_sync";

  var statusBanner = document.getElementById("statusBanner");
  var createPackageTitle = document.getElementById("createPackageTitle");
  var createPackageExpiration = document.getElementById("createPackageExpiration");
  var uploadFile = document.getElementById("uploadFile");
  var btnUploadPackage = document.getElementById("btnUploadPackage");
  var uploadMsg = document.getElementById("uploadMsg");
  var createGroupFilter = document.getElementById("createGroupFilter");
  var createGroupsBox = document.getElementById("createGroupsBox");
  var createGroupsInner = document.getElementById("createGroupsInner");
  var createSelectAllGroupsBtn = document.getElementById("createSelectAllGroupsBtn");
  var createClearAllGroupsBtn = document.getElementById("createClearAllGroupsBtn");
  var createPickedGroups = {};
  var packageFilter = document.getElementById("packageFilter");
  var packagesMsg = document.getElementById("packagesMsg");
  var archivedPackagesMsg = document.getElementById("archivedPackagesMsg");
  var packagesTbody = document.getElementById("packagesTbody");
  var archivedPackagesTbody = document.getElementById("archivedPackagesTbody");
  var archivedCount = document.getElementById("archivedCount");
  var bulkActionSelect = document.getElementById("bulkActionSelect");
  var bulkActionApplyBtn = document.getElementById("bulkActionApplyBtn");
  var bulkActionsWrap = document.getElementById("bulkActionsWrap");
  var activeSelectAllChk = document.getElementById("activeSelectAllChk");
  var archivedSelectAllChk = document.getElementById("archivedSelectAllChk");

  var packageModal = document.getElementById("packageModal");
  var packageModalClose = document.getElementById("packageModalClose");
  var packageModalTitle = document.getElementById("packageModalTitle");
  var packageModalMsg = document.getElementById("packageModalMsg");
  var pkgTitle = document.getElementById("pkgTitle");
  var pkgExpiration = document.getElementById("pkgExpiration");
  var pkgBtnSave = document.getElementById("pkgBtnSave");
  var editGroupsSearch = document.getElementById("editGroupsSearch");
  var editGroupsBox = document.getElementById("editGroupsBox");
  var editGroupsInner = document.getElementById("editGroupsInner");
  var editGroupsSelectAll = document.getElementById("editGroupsSelectAll");
  var editGroupsClear = document.getElementById("editGroupsClear");
  var editGroupsSummary = document.getElementById("editGroupsSummary");
  var editPickedGroups = {};
  var editingHash = "";
  var editingFilename = "";

  var packagesCache = [];
  var groupsCache = [];
  var loadPackagesDebounceTimer = null;
  var selectedPackages = {};

  function esc(s) {
    return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  function setMsg(el, text, ok) {
    if (!el) return;
    el.textContent = text || "";
    el.className = "msg " + (ok === true ? "ok" : ok === false ? "bad" : "");
  }
  function firstVal(obj, keys) {
    if (!obj || typeof obj !== "object") return "";
    for (var i = 0; i < keys.length; i++) {
      var k = keys[i];
      if (obj[k] != null && obj[k] !== "") return String(obj[k]);
    }
    return "";
  }
  function asNumber(v) {
    var n = Number(v);
    return Number.isFinite(n) ? n : null;
  }
  function fmtSize(v) {
    var raw = String(v == null ? "" : v).trim();
    if (!raw) return "";
    var n = asNumber(v);
    if (n == null || n < 0) return raw;
    if (n < 1024) return n + " B";
    if (n < 1024 * 1024) return (n / 1024).toFixed(1) + " KB";
    return (n / (1024 * 1024)).toFixed(1) + " MB";
  }
  function normalizeList(payload) {
    if (!payload) return [];
    if (Array.isArray(payload.items)) return payload.items;
    if (Array.isArray(payload.data)) return payload.data;
    if (Array.isArray(payload)) return payload;
    return [];
  }
  function selectedCount() {
    return Object.keys(selectedPackages).length;
  }
  function updateBulkActionButtonState() {
    var count = selectedCount();
    if (bulkActionsWrap) bulkActionsWrap.style.display = count > 0 ? "" : "none";
    if (!bulkActionApplyBtn) return;
    bulkActionApplyBtn.disabled = count <= 0 || !bulkActionSelect || !String(bulkActionSelect.value || "");
    bulkActionApplyBtn.textContent = count > 0 ? ("Apply (" + count + ")") : "Apply";
  }
  function syncSelectAllCheckboxes() {
    var activeRows = packagesTbody ? Array.from(packagesTbody.querySelectorAll("input.pkg-row-chk[data-archived='false']")) : [];
    var archivedRows = archivedPackagesTbody ? Array.from(archivedPackagesTbody.querySelectorAll("input.pkg-row-chk[data-archived='true']")) : [];
    if (activeSelectAllChk) {
      activeSelectAllChk.checked = activeRows.length > 0 && activeRows.every(function (cb) { return cb.checked; });
      activeSelectAllChk.indeterminate = activeRows.some(function (cb) { return cb.checked; }) && !activeSelectAllChk.checked;
    }
    if (archivedSelectAllChk) {
      archivedSelectAllChk.checked = archivedRows.length > 0 && archivedRows.every(function (cb) { return cb.checked; });
      archivedSelectAllChk.indeterminate = archivedRows.some(function (cb) { return cb.checked; }) && !archivedSelectAllChk.checked;
    }
    updateBulkActionButtonState();
  }
  function setSelection(hash, metaOrNull) {
    var key = String(hash || "").trim();
    if (!key) return;
    if (metaOrNull) selectedPackages[key] = metaOrNull;
    else delete selectedPackages[key];
    syncSelectAllCheckboxes();
  }
  function normalizeKeywords(pkg) {
    if (Array.isArray(pkg.keywords)) {
      return pkg.keywords.map(function (k) { return String(k || "").trim(); }).filter(Boolean);
    }
    var raw = firstVal(pkg, ["keywords", "Keywords", "keyword", "tags"]);
    if (!raw) return [];
    return String(raw).split(",").map(function (k) { return k.trim(); }).filter(Boolean);
  }
  function hasKeyword(pkg, keyword) {
    var target = String(keyword || "").trim().toLowerCase();
    var list = normalizeKeywords(pkg);
    for (var i = 0; i < list.length; i++) {
      if (String(list[i]).toLowerCase() === target) return true;
    }
    return false;
  }

  function isDataPackageRow(pkg) {
    if (!pkg) return false;
    if (pkg.portalKindIsDataSync || String(pkg.portalKind || "").toLowerCase() === DATA_SYNC_KIND) {
      return false;
    }
    return true;
  }

  function parsePackageGroupsField(groupsRaw) {
    if (Array.isArray(groupsRaw)) {
      return groupsRaw.map(function (g) { return String(g || "").trim(); }).filter(Boolean);
    }
    var raw = String(groupsRaw || "").trim();
    if (!raw) return [];
    return raw.split(",").map(function (g) { return g.trim(); }).filter(Boolean);
  }

  function packageGroupNames(pkg) {
    return parsePackageGroupsField(firstVal(pkg, ["groups", "Groups", "group", "Group"]));
  }

  function packageTitle(pkg) {
    return firstVal(pkg, ["filename", "name", "title", "original_filename"]);
  }

  function toDatetimeLocalValue(raw) {
    if (raw == null || raw === "") return "";
    var s = String(raw).trim();
    if (!s || /^none$/i.test(s)) return "";
    var ms = /^\d+$/.test(s) ? Number(s) : Date.parse(s);
    if (!Number.isFinite(ms) || ms <= 0) return "";
    if (ms < 1e12) ms = ms * 1000;
    var d = new Date(ms);
    if (Number.isNaN(d.getTime())) return "";
    function pad(n) { return String(n).padStart(2, "0"); }
    return (
      d.getFullYear() +
      "-" +
      pad(d.getMonth() + 1) +
      "-" +
      pad(d.getDate()) +
      "T" +
      pad(d.getHours()) +
      ":" +
      pad(d.getMinutes())
    );
  }

  function maybeAutofillTitleFromZip() {
    if (!createPackageTitle || !uploadFile || !uploadFile.files || !uploadFile.files[0]) return;
    if (String(createPackageTitle.value || "").trim()) return;
    var name = String(uploadFile.files[0].name || "").trim();
    createPackageTitle.value = name.replace(/\.[^.\\/]+$/, "");
  }

  function formatChannelsCellHtml(channelNames) {
    var names = Array.isArray(channelNames) ? channelNames : [];
    if (!names.length) return "<span class=\"muted\">—</span>";
    if (names.length === 1) return esc(names[0]);
    return names
      .map(function (n) {
        return '<div class="data-packages-channel-item">' + esc(n) + "</div>";
      })
      .join("");
  }

  function canonicalGroupKey(name) {
    var n = String(name || "").trim().toLowerCase();
    if (n.indexOf("tak_") === 0) n = n.slice(4);
    return n.replace(/\s+/g, " ").trim();
  }

  function resolveToGroupsCache(name) {
    var n = String(name || "").trim();
    if (!n) return null;
    if (groupsCache.indexOf(n) >= 0) return n;
    var nl = n.toLowerCase();
    for (var i = 0; i < groupsCache.length; i++) {
      if (groupsCache[i].toLowerCase() === nl) return groupsCache[i];
    }
    return null;
  }

  function pickedGroupsList(pickedMap) {
    return Object.keys(pickedMap || {}).filter(function (k) { return !!pickedMap[k]; }).sort(function (a, b) {
      return a.localeCompare(b);
    });
  }

  function clearPickedGroups(pickedMap) {
    Object.keys(pickedMap || {}).forEach(function (k) { delete pickedMap[k]; });
  }

  function setPickedGroups(pickedMap, names) {
    clearPickedGroups(pickedMap);
    (names || []).forEach(function (raw) {
      var n = String(raw || "").trim();
      if (!n) return;
      var canon = resolveToGroupsCache(n) || n;
      pickedMap[canon] = true;
    });
  }

  function groupNamesForPicker(pickedMap) {
    var names = groupsCache.slice();
    var seen = {};
    for (var i = 0; i < names.length; i++) seen[canonicalGroupKey(names[i])] = true;
    pickedGroupsList(pickedMap).forEach(function (n) {
      var key = canonicalGroupKey(n);
      if (!key || seen[key]) return;
      seen[key] = true;
      names.push(n);
    });
    names.sort(function (a, b) { return a.localeCompare(b); });
    return names;
  }

  function filterGroupNames(names, filterText) {
    var q = String(filterText || "").trim().toLowerCase();
    if (!q) return names;
    return names.filter(function (n) {
      return String(n || "").toLowerCase().indexOf(q) >= 0;
    });
  }

  function renderCreateGroupsList() {
    if (!createGroupsInner) return;
    var names = filterGroupNames(groupNamesForPicker(createPickedGroups), createGroupFilter && createGroupFilter.value);
    if (!names.length) {
      createGroupsInner.innerHTML =
        '<p class="muted" style="margin:0;padding:8px;">' +
        (groupsCache.length ? "No matching groups." : "No groups found.") +
        "</p>";
      return;
    }
    createGroupsInner.innerHTML = names.map(function (name) {
      var checked = createPickedGroups[name] ? " checked" : "";
      return (
        '<label class="groupItem">' +
          '<input type="checkbox" value="' + esc(name) + '"' + checked + " />" +
          "<span>" + esc(name) + "</span>" +
        "</label>"
      );
    }).join("");
  }

  function updateEditGroupsSummary() {
    var count = pickedGroupsList(editPickedGroups).length;
    if (!editGroupsSummary) return;
    editGroupsSummary.textContent = count
      ? (count === 1 ? "1 group selected" : count + " groups selected")
      : "No groups selected";
  }

  function renderEditGroupsList() {
    if (!editGroupsInner) return;
    var names = filterGroupNames(groupNamesForPicker(editPickedGroups), editGroupsSearch && editGroupsSearch.value);
    if (!names.length) {
      editGroupsInner.innerHTML =
        '<p class="muted" style="margin:0;padding:8px;">' +
        (groupsCache.length ? "No matching groups." : "No groups found.") +
        "</p>";
      updateEditGroupsSummary();
      return;
    }
    editGroupsInner.innerHTML = names.map(function (name) {
      var checked = editPickedGroups[name] ? " checked" : "";
      return (
        '<label class="groupItem">' +
          '<input type="checkbox" value="' + esc(name) + '"' + checked + " />" +
          "<span>" + esc(name) + "</span>" +
        "</label>"
      );
    }).join("");
    updateEditGroupsSummary();
  }

  function normalizeGroupNamesPayload(payload) {
    if (!payload) return [];
    if (Array.isArray(payload.data)) return payload.data.map(function (n) { return String(n || "").trim(); }).filter(Boolean);
    if (Array.isArray(payload)) return payload.map(function (n) { return String(n || "").trim(); }).filter(Boolean);
    return [];
  }

  async function loadGroups() {
    var res = await fetch(API + "/groups");
    var j = await res.json();
    if (!res.ok) throw new Error((j && j.error) || "Failed to load groups");
    groupsCache = normalizeGroupNamesPayload(j).sort(function (a, b) { return a.localeCompare(b); });
    renderCreateGroupsList();
    renderEditGroupsList();
    return groupsCache;
  }

  async function loadStatus() {
    try {
      var res = await fetch(API + "/status");
      var j = await res.json();
      if (!res.ok) throw new Error((j && j.error) || "Status failed");
      if (!j.configured) {
        statusBanner.style.display = "block";
        statusBanner.className = "card data-packages-status msg bad";
        statusBanner.innerHTML = "<strong>TAK is not available from the portal.</strong> " +
          (j.bypassed ? "TAK_BYPASS_ENABLED is on, or TAK_URL / client certificates are not configured." : "Set TAK_URL and API client cert/key or P12 in Server Settings.");
        return false;
      }
      statusBanner.style.display = "none";
      statusBanner.innerHTML = "";
      return true;
    } catch (e) {
      statusBanner.style.display = "block";
      statusBanner.className = "card data-packages-status msg bad";
      statusBanner.textContent = e.message || "Could not load status.";
      return false;
    }
  }

  function renderOneRow(pkg, tbody, isArchived) {
    var title = packageTitle(pkg);
    var hash = firstVal(pkg, ["hash", "sha256", "uid", "id"]);
    var size = firstVal(pkg, ["size", "content_length", "contentLength"]);
    var creator = firstVal(pkg, ["creator_uid", "creatorUid", "creator", "owner"]);
    var expirationRaw = firstVal(pkg, ["expiration", "Expiration", "expires", "expiresAt"]);
    var expiration =
      !expirationRaw || /^none$/i.test(String(expirationRaw).trim())
        ? "—"
        : String(expirationRaw).trim();
    var created = firstVal(pkg, ["created_at", "createTime", "created", "timestamp"]);
    var channelNames = packageGroupNames(pkg);

    var tr = document.createElement("tr");
    tr.innerHTML =
      "<td class=\"pkgCheckCell\" style='width:42px;'><input type='checkbox' class='pkg-row-chk' data-hash='" + esc(hash) + "' data-filename='" + esc(title || "") + "' data-archived='" + (isArchived ? "true" : "false") + "' aria-label='Select package' /></td>" +
      "<td class=\"cardTitleCell\" style='max-width:240px;'><div class=\"cardTitleText\">" + esc(title || "(unnamed)") + "</div></td>" +
      "<td class=\"pkgChannelsCell\" data-label=\"Channels\" style='font-size:13px;'>" + formatChannelsCellHtml(channelNames) + "</td>" +
      "<td class=\"pkgSizeCell\" data-label=\"Size\" style='white-space:nowrap;'>" + esc(fmtSize(size)) + "</td>" +
      "<td class=\"data-packages-col-creator\" data-label=\"Creator\">" + esc(creator) + "</td>" +
      "<td class=\"data-packages-col-expiration\" data-label=\"Expiration\" style='white-space:nowrap;font-size:12px;'>" + esc(expiration) + "</td>" +
      "<td class=\"data-packages-col-updated\" data-label=\"Last Updated\" style='font-size:12px;white-space:nowrap;'>" + esc(created) + "</td>" +
      "<td></td>";

    var tdAct = tr.querySelector("td:last-child");
    tdAct.className = "data-packages-actions-cell cardActionsCell";
    var rowChk = tr.querySelector("input.pkg-row-chk");
    if (rowChk && hash) {
      var key = String(hash).trim();
      rowChk.checked = !!selectedPackages[key];
      rowChk.addEventListener("change", function () {
        if (rowChk.checked) {
          setSelection(key, {
            hash: key,
            filename: title || "",
            isArchived: !!isArchived
          });
        } else {
          setSelection(key, null);
        }
      });
    } else if (rowChk) {
      rowChk.disabled = true;
    }

    var bEdit = document.createElement("button");
    bEdit.type = "button";
    bEdit.className = "btn";
    bEdit.textContent = "Edit";
    bEdit.disabled = !hash || !!isArchived;
    bEdit.addEventListener("click", function () { openEditPackage(hash, title); });

    var bDl = document.createElement("button");
    bDl.type = "button";
    bDl.className = "btn";
    bDl.textContent = "Download";
    bDl.disabled = !hash;
    bDl.addEventListener("click", function () { downloadPackage(hash, title); });

    var bDel = document.createElement("button");
    bDel.type = "button";
    bDel.className = "btn danger";
    bDel.textContent = "Delete";
    bDel.disabled = !hash;
    bDel.addEventListener("click", function () { deletePackage(hash, title, isArchived); });

    var bArchiveRestore = document.createElement("button");
    bArchiveRestore.type = "button";
    bArchiveRestore.disabled = !hash;
    if (isArchived) {
      bArchiveRestore.className = "btn success";
      bArchiveRestore.textContent = "Restore";
      bArchiveRestore.addEventListener("click", function () { restorePackage(hash, title); });
    } else {
      bArchiveRestore.className = "btn caution";
      bArchiveRestore.textContent = "Archive";
      bArchiveRestore.addEventListener("click", function () { archivePackage(hash, title); });
    }

    if (!isArchived) tdAct.appendChild(bEdit);
    tdAct.appendChild(bDl);
    tdAct.appendChild(bArchiveRestore);
    tdAct.appendChild(bDel);
    var actWrap = document.createElement("div");
    actWrap.className = "cardActionsRow";
    while (tdAct.firstChild) actWrap.appendChild(tdAct.firstChild);
    tdAct.appendChild(actWrap);
    tbody.appendChild(tr);
  }

  function renderTables() {
    var filt = ((packageFilter && packageFilter.value) || "").trim().toLowerCase();
    packagesTbody.innerHTML = "";
    archivedPackagesTbody.innerHTML = "";

    var activeCount = 0;
    var archivedCountValue = 0;
    for (var i = 0; i < packagesCache.length; i++) {
      var p = packagesCache[i] || {};
      var hay = (
        packageTitle(p) + " " +
        firstVal(p, ["creator_uid", "creatorUid", "creator", "owner"]) + " " +
        normalizeKeywords(p).join(" ")
      ).toLowerCase();
      if (filt && hay.indexOf(filt) === -1) continue;

      if (hasKeyword(p, ACTIVE_KEYWORD) && isDataPackageRow(p)) {
        activeCount += 1;
        renderOneRow(p, packagesTbody, false);
      } else if (hasKeyword(p, ARCHIVED_KEYWORD) && isDataPackageRow(p)) {
        archivedCountValue += 1;
        renderOneRow(p, archivedPackagesTbody, true);
      }
    }

    if (!activeCount) {
      var trA = document.createElement("tr");
      trA.className = "emptyStateRow";
      var tdA = document.createElement("td");
      tdA.colSpan = 8;
      tdA.textContent = "No active mission packages.";
      trA.appendChild(tdA);
      packagesTbody.appendChild(trA);
    }
    if (!archivedCountValue) {
      var trR = document.createElement("tr");
      trR.className = "emptyStateRow";
      var tdR = document.createElement("td");
      tdR.colSpan = 8;
      tdR.textContent = "No archived mission packages.";
      trR.appendChild(tdR);
      archivedPackagesTbody.appendChild(trR);
    }
    if (archivedCount) archivedCount.textContent = String(archivedCountValue);
    syncSelectAllCheckboxes();
  }

  async function loadPackages() {
    setMsg(packagesMsg, "Loading packages…", undefined);
    setMsg(archivedPackagesMsg, "", undefined);
    try {
      var res = await fetch(API + "/packages");
      var text = await res.text();
      var j = {};
      try { j = JSON.parse(text); } catch (_) {}
      if (!res.ok) throw new Error((j && j.error) || "Failed to load packages");
      packagesCache = normalizeList(j);
      renderTables();
      setMsg(packagesMsg, "", true);
      setMsg(archivedPackagesMsg, "", true);
    } catch (e) {
      setMsg(packagesMsg, e.message || "Failed to load packages", false);
      setMsg(archivedPackagesMsg, e.message || "Failed to load archived packages", false);
    }
  }

  async function uploadPackage() {
    setMsg(uploadMsg, "Uploading…", undefined);
    try {
      var file = uploadFile && uploadFile.files && uploadFile.files[0];
      if (!file) throw new Error("Choose a file to upload.");
      var fileName = String(file.name || "").toLowerCase();
      if (!fileName.endsWith(".zip")) throw new Error("Only .zip files are allowed.");
      maybeAutofillTitleFromZip();
      var title = createPackageTitle ? String(createPackageTitle.value || "").trim() : "";
      if (!title) title = String(file.name || "").trim();
      if (!title) throw new Error("Title is required.");
      var groups = pickedGroupsList(createPickedGroups);
      if (!groups.length) throw new Error("Select at least one assigned group / channel.");
      var expiration = createPackageExpiration ? String(createPackageExpiration.value || "").trim() : "";
      if (expiration) {
        var expMs = Date.parse(expiration);
        if (!Number.isFinite(expMs)) throw new Error("Expiration date/time is invalid.");
        if (expMs <= Date.now()) throw new Error("Expiration date/time must be in the future.");
      }

      var fd = new FormData();
      fd.append("file", file, file.name || "data-package.zip");
      fd.append("title", title);
      fd.append("keywords", ACTIVE_KEYWORD);
      fd.append("tool", "public");
      fd.append("groups", JSON.stringify(groups));
      if (expiration) fd.append("expiration", expiration);

      var res = await fetch(API + "/packages/upload", { method: "POST", body: fd });
      var text = await res.text();
      var j = {};
      try { j = JSON.parse(text); } catch (_) {}
      if (!res.ok) throw new Error((j && j.error) || "Upload failed");
      setMsg(uploadMsg, "Data package uploaded.", true);
      uploadFile.value = "";
      if (createPackageTitle) createPackageTitle.value = "";
      if (createPackageExpiration) createPackageExpiration.value = "";
      clearPickedGroups(createPickedGroups);
      if (createGroupFilter) createGroupFilter.value = "";
      renderCreateGroupsList();
      await loadPackages();
    } catch (e) {
      setMsg(uploadMsg, e.message || "Upload failed", false);
    }
  }

  function openModal() {
    if (!packageModal) return;
    packageModal.style.display = "flex";
    document.body.classList.add("noScroll");
  }

  function closeModal() {
    if (!packageModal) return;
    packageModal.style.display = "none";
    document.body.classList.remove("noScroll");
    editingHash = "";
    editingFilename = "";
    clearPickedGroups(editPickedGroups);
    if (editGroupsSearch) editGroupsSearch.value = "";
    if (pkgExpiration) pkgExpiration.value = "";
    renderEditGroupsList();
  }

  function setPackageModalMsg(text, ok) {
    setMsg(packageModalMsg, text, ok);
  }

  function findCachedPackage(hash, filename) {
    var wantHash = String(hash || "").trim().toLowerCase();
    var wantName = String(filename || "").trim();
    if (!wantHash) return null;
    var hashMatches = [];
    for (var i = 0; i < packagesCache.length; i++) {
      var p = packagesCache[i];
      var h = String(firstVal(p, ["hash", "sha256", "uid", "id"]) || "").trim().toLowerCase();
      if (h !== wantHash) continue;
      hashMatches.push(p);
      if (wantName) {
        var title = packageTitle(p);
        if (
          String(title || "").trim().toLowerCase() === wantName.toLowerCase() ||
          String(title || "").trim().replace(/\.zip$/i, "").toLowerCase() ===
            wantName.replace(/\.zip$/i, "").toLowerCase()
        ) {
          return p;
        }
      }
    }
    // Name was provided: do not return a hash twin with a different title.
    if (wantName) return null;
    return hashMatches[0] || null;
  }

  async function openEditPackage(hash, filename) {
    editingHash = String(hash || "").trim();
    editingFilename = String(filename || "").trim();
    if (!editingHash) return;
    if (packageModalTitle) packageModalTitle.textContent = "Edit Data Package";
    if (pkgTitle) pkgTitle.value = editingFilename || "";
    if (pkgExpiration) pkgExpiration.value = "";
    setPackageModalMsg("Loading…", undefined);
    if (editGroupsSearch) editGroupsSearch.value = "";
    openModal();
    try {
      if (!groupsCache.length) await loadGroups();
      // Seed from the clicked list row first — Marti often has multiple rows per hash.
      var cached = findCachedPackage(editingHash, editingFilename);
      var groups = cached ? packageGroupNames(cached) : [];
      if (cached && pkgTitle) {
        var cachedTitle = packageTitle(cached);
        if (cachedTitle) pkgTitle.value = cachedTitle;
      }
      if (cached && pkgExpiration) {
        pkgExpiration.value = toDatetimeLocalValue(
          firstVal(cached, ["expiration", "Expiration", "expires", "expiresAt"])
        );
      }
      var metaUrl =
        API +
        "/packages/" +
        encodeURIComponent(editingHash) +
        "/metadata" +
        (editingFilename
          ? "?fileName=" + encodeURIComponent(editingFilename)
          : "");
      var res = await fetch(metaUrl);
      var text = await res.text();
      var j = {};
      try { j = JSON.parse(text); } catch (_) {}
      if (res.ok) {
        var loadedTitle = firstVal(j, ["name", "title", "filename", "original_filename"]);
        // Only accept metadata title when it matches the selected package (or no name hint).
        if (pkgTitle && loadedTitle) {
          if (
            !editingFilename ||
            String(loadedTitle).trim().toLowerCase() === editingFilename.toLowerCase() ||
            String(loadedTitle).trim().replace(/\.zip$/i, "").toLowerCase() ===
              editingFilename.replace(/\.zip$/i, "").toLowerCase()
          ) {
            pkgTitle.value = loadedTitle;
          }
        }
        var metaGroups = parsePackageGroupsField(j.groups);
        if (metaGroups.length) groups = metaGroups;
        if (pkgExpiration) {
          var metaExp = firstVal(j, ["expiration", "Expiration", "expires", "expiresAt"]);
          var localExp = toDatetimeLocalValue(metaExp);
          if (localExp) pkgExpiration.value = localExp;
        }
      } else if (!cached) {
        throw new Error((j && j.error) || "Failed to load package");
      }
      if (pkgTitle && !String(pkgTitle.value || "").trim()) {
        pkgTitle.value = editingFilename || "";
      }
      setPickedGroups(editPickedGroups, groups);
      renderEditGroupsList();
      setPackageModalMsg("", true);
    } catch (e) {
      setPackageModalMsg(e.message || "Failed to load package", false);
    }
  }

  async function savePackage() {
    setPackageModalMsg("Saving…", undefined);
    try {
      if (!editingHash) throw new Error("Package hash missing.");
      var title = pkgTitle ? String(pkgTitle.value || "").trim() : "";
      if (!title) throw new Error("Title is required.");
      var groups = pickedGroupsList(editPickedGroups);
      if (!groups.length) throw new Error("Select at least one assigned group / channel.");
      var expiration = pkgExpiration ? String(pkgExpiration.value || "").trim() : "";
      if (expiration) {
        var expMs = Date.parse(expiration);
        if (!Number.isFinite(expMs)) throw new Error("Expiration date/time is invalid.");
        if (expMs <= Date.now()) throw new Error("Expiration date/time must be in the future.");
      }
      var res = await fetch(API + "/packages/" + encodeURIComponent(editingHash) + "/metadata", {
        method: "PUT",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          title: title,
          name: title,
          filename: title,
          groups: groups,
          fileName: title,
          priorFileName: editingFilename || undefined,
          expiration: expiration || undefined,
        }),
      });
      var text = await res.text();
      var j = {};
      try { j = JSON.parse(text); } catch (_) {}
      if (!res.ok) throw new Error((j && j.error) || "Save failed");
      closeModal();
      setMsg(packagesMsg, "Package saved.", true);
      await loadPackages();
    } catch (e) {
      setPackageModalMsg(e.message || "Save failed", false);
    }
  }

  async function deletePackage(hash, filename, isArchived) {
    var warning =
      "Permanently delete data package \"" + (filename || hash) + "\"?\n\n" +
      "This is PERMANENT and cannot be undone.\n" +
      "Use Archive if you may need this package later.";
    if (!window.confirm(warning)) return;
    setMsg(isArchived ? archivedPackagesMsg : packagesMsg, "Deleting package…", undefined);
    try {
      var res = await fetch(API + "/packages/" + encodeURIComponent(hash) + "?fileName=" + encodeURIComponent(filename || ""), { method: "DELETE" });
      var text = await res.text();
      var j = {};
      try { j = JSON.parse(text); } catch (_) {}
      if (!res.ok) throw new Error((j && j.error) || "Delete failed");
      setMsg(isArchived ? archivedPackagesMsg : packagesMsg, "Package deleted.", true);
      await loadPackages();
    } catch (e) {
      setMsg(isArchived ? archivedPackagesMsg : packagesMsg, e.message || "Delete failed", false);
    }
  }

  async function archivePackage(hash, filename) {
    if (!window.confirm("Archive \"" + (filename || hash) + "\"?")) return;
    setMsg(packagesMsg, "Archiving package…", undefined);
    try {
      var res = await fetch(API + "/packages/" + encodeURIComponent(hash) + "/metadata", {
        method: "PUT",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ keywords: [ARCHIVED_KEYWORD] }),
      });
      var text = await res.text();
      var j = {};
      try { j = JSON.parse(text); } catch (_) {}
      if (!res.ok) throw new Error((j && j.error) || "Archive failed");
      setMsg(packagesMsg, "Package archived.", true);
      await loadPackages();
    } catch (e) {
      setMsg(packagesMsg, e.message || "Archive failed", false);
    }
  }

  async function restorePackage(hash, filename) {
    if (!window.confirm("Restore \"" + (filename || hash) + "\" to active packages?")) return;
    setMsg(archivedPackagesMsg, "Restoring package…", undefined);
    try {
      var res = await fetch(API + "/packages/" + encodeURIComponent(hash) + "/metadata", {
        method: "PUT",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ keywords: [ACTIVE_KEYWORD] }),
      });
      var text = await res.text();
      var j = {};
      try { j = JSON.parse(text); } catch (_) {}
      if (!res.ok) throw new Error((j && j.error) || "Restore failed");
      setMsg(archivedPackagesMsg, "Package restored.", true);
      await loadPackages();
    } catch (e) {
      setMsg(archivedPackagesMsg, e.message || "Restore failed", false);
    }
  }

  function zipDownloadName(filename, hash) {
    var base = String(filename || "").trim() || ("data-package-" + String(hash || "file").slice(0, 16));
    if (!/\.zip$/i.test(base)) base += ".zip";
    return base;
  }

  async function downloadPackage(hash, filename) {
    setMsg(packagesMsg, "Downloading package…", undefined);
    try {
      var res = await fetch(API + "/packages/download?hash=" + encodeURIComponent(hash) + "&fileName=" + encodeURIComponent(filename || ""));
      if (!res.ok) throw new Error("Download failed (HTTP " + res.status + ")");
      var blob = await res.blob();
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = zipDownloadName(filename, hash);
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function () {
        try { URL.revokeObjectURL(a.href); } catch (_) {}
      }, 2500);
      setMsg(packagesMsg, "Download started.", true);
    } catch (e) {
      setMsg(packagesMsg, e.message || "Download failed", false);
    }
  }

  async function bulkApplyAction() {
    var action = String((bulkActionSelect && bulkActionSelect.value) || "").trim();
    var selectedKeys = Object.keys(selectedPackages);
    if (!action) {
      setMsg(packagesMsg, "Choose a bulk action first.", false);
      return;
    }
    if (!selectedKeys.length) {
      setMsg(packagesMsg, "Select at least one package.", false);
      return;
    }

    if (action === "download") {
      setMsg(packagesMsg, "Starting downloads for selected packages...", undefined);
      var downloaded = 0;
      for (var i = 0; i < selectedKeys.length; i++) {
        var m = selectedPackages[selectedKeys[i]];
        if (!m || !m.hash) continue;
        try {
          var res = await fetch(
            API + "/packages/download?hash=" + encodeURIComponent(m.hash) +
              "&fileName=" + encodeURIComponent(m.filename || "")
          );
          if (!res.ok) throw new Error("HTTP " + res.status);
          var blob = await res.blob();
          var a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = zipDownloadName(m.filename, m.hash);
          document.body.appendChild(a);
          a.click();
          a.remove();
          downloaded += 1;
          (function (u) {
            setTimeout(function () {
              try { URL.revokeObjectURL(u); } catch (_) {}
            }, 2500);
          })(a.href);
        } catch (_) {}
      }
      setMsg(packagesMsg, "Started " + downloaded + " download(s).", true);
      return;
    }

    if (action === "archive") {
      var toArchive = selectedKeys
        .map(function (k) { return selectedPackages[k]; })
        .filter(function (m) { return m && m.hash && !m.isArchived; });
      if (!toArchive.length) {
        setMsg(packagesMsg, "No active selected packages to archive.", false);
        return;
      }
      if (!window.confirm("Archive " + toArchive.length + " selected package(s)?")) return;
      setMsg(packagesMsg, "Archiving selected packages...", undefined);
      var archivedOk = 0;
      for (var j = 0; j < toArchive.length; j++) {
        var x = toArchive[j];
        try {
          var r = await fetch(API + "/packages/" + encodeURIComponent(x.hash) + "/metadata", {
            method: "PUT",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ keywords: [ARCHIVED_KEYWORD] }),
          });
          if (r.ok) archivedOk += 1;
        } catch (_) {}
      }
      selectedPackages = {};
      setMsg(packagesMsg, "Archived " + archivedOk + " package(s).", true);
      await loadPackages();
      return;
    }

    if (action === "delete") {
      if (!window.confirm(
        "Permanently delete " + selectedKeys.length + " selected package(s)?\n\n" +
        "This is PERMANENT and cannot be undone."
      )) return;
      setMsg(packagesMsg, "Deleting selected packages...", undefined);
      var deletedOk = 0;
      for (var k = 0; k < selectedKeys.length; k++) {
        var d = selectedPackages[selectedKeys[k]];
        if (!d || !d.hash) continue;
        try {
          var delRes = await fetch(
            API + "/packages/" + encodeURIComponent(d.hash) +
              "?fileName=" + encodeURIComponent(d.filename || ""),
            { method: "DELETE" }
          );
          if (delRes.ok) deletedOk += 1;
        } catch (_) {}
      }
      selectedPackages = {};
      setMsg(packagesMsg, "Deleted " + deletedOk + " package(s).", true);
      await loadPackages();
    }
  }

  if (btnUploadPackage) btnUploadPackage.addEventListener("click", uploadPackage);
  if (uploadFile) {
    uploadFile.addEventListener("change", function () {
      maybeAutofillTitleFromZip();
    });
  }
  if (packageModalClose) packageModalClose.addEventListener("click", closeModal);
  if (packageModal) {
    packageModal.addEventListener("click", function (e) {
      if (e.target === packageModal) closeModal();
    });
  }
  if (pkgBtnSave) pkgBtnSave.addEventListener("click", savePackage);

  if (createGroupsBox) {
    createGroupsBox.addEventListener("change", function (e) {
      var cb = e.target;
      if (!cb || cb.tagName !== "INPUT" || cb.type !== "checkbox") return;
      var value = String(cb.value || "").trim();
      if (!value) return;
      if (cb.checked) createPickedGroups[value] = true;
      else delete createPickedGroups[value];
    });
  }
  if (createGroupFilter) {
    createGroupFilter.addEventListener("input", function () {
      renderCreateGroupsList();
    });
  }
  if (createSelectAllGroupsBtn) {
    createSelectAllGroupsBtn.addEventListener("click", function () {
      filterGroupNames(groupNamesForPicker(createPickedGroups), createGroupFilter && createGroupFilter.value)
        .forEach(function (name) { createPickedGroups[name] = true; });
      renderCreateGroupsList();
    });
  }
  if (createClearAllGroupsBtn) {
    createClearAllGroupsBtn.addEventListener("click", function () {
      clearPickedGroups(createPickedGroups);
      renderCreateGroupsList();
    });
  }

  if (editGroupsBox) {
    editGroupsBox.addEventListener("change", function (e) {
      var cb = e.target;
      if (!cb || cb.tagName !== "INPUT" || cb.type !== "checkbox") return;
      var value = String(cb.value || "").trim();
      if (!value) return;
      if (cb.checked) editPickedGroups[value] = true;
      else delete editPickedGroups[value];
      updateEditGroupsSummary();
    });
  }
  if (editGroupsSearch) {
    editGroupsSearch.addEventListener("input", function () {
      renderEditGroupsList();
    });
  }
  if (editGroupsSelectAll) {
    editGroupsSelectAll.addEventListener("click", function () {
      filterGroupNames(groupNamesForPicker(editPickedGroups), editGroupsSearch && editGroupsSearch.value)
        .forEach(function (name) { editPickedGroups[name] = true; });
      renderEditGroupsList();
    });
  }
  if (editGroupsClear) {
    editGroupsClear.addEventListener("click", function () {
      clearPickedGroups(editPickedGroups);
      renderEditGroupsList();
    });
  }

  if (bulkActionSelect) bulkActionSelect.addEventListener("change", updateBulkActionButtonState);
  if (bulkActionApplyBtn) bulkActionApplyBtn.addEventListener("click", bulkApplyAction);
  if (activeSelectAllChk) {
    activeSelectAllChk.addEventListener("change", function () {
      var checked = !!activeSelectAllChk.checked;
      var rows = packagesTbody ? Array.from(packagesTbody.querySelectorAll("input.pkg-row-chk[data-archived='false']")) : [];
      rows.forEach(function (cb) {
        if (cb.disabled) return;
        cb.checked = checked;
        var key = String(cb.getAttribute("data-hash") || "").trim();
        if (!key) return;
        if (checked) {
          var fileName = String(cb.getAttribute("data-filename") || "").trim();
          selectedPackages[key] = {
            hash: key,
            filename: fileName,
            isArchived: false
          };
        } else {
          delete selectedPackages[key];
        }
      });
      syncSelectAllCheckboxes();
    });
  }
  if (archivedSelectAllChk) {
    archivedSelectAllChk.addEventListener("change", function () {
      var checked = !!archivedSelectAllChk.checked;
      var rows = archivedPackagesTbody ? Array.from(archivedPackagesTbody.querySelectorAll("input.pkg-row-chk[data-archived='true']")) : [];
      rows.forEach(function (cb) {
        if (cb.disabled) return;
        cb.checked = checked;
        var key = String(cb.getAttribute("data-hash") || "").trim();
        if (!key) return;
        if (checked) {
          var fileName = String(cb.getAttribute("data-filename") || "").trim();
          selectedPackages[key] = {
            hash: key,
            filename: fileName,
            isArchived: true
          };
        } else {
          delete selectedPackages[key];
        }
      });
      syncSelectAllCheckboxes();
    });
  }
  if (packageFilter) {
    packageFilter.addEventListener("input", function () {
      if (loadPackagesDebounceTimer) clearTimeout(loadPackagesDebounceTimer);
      loadPackagesDebounceTimer = setTimeout(function () {
        loadPackages();
      }, 250);
    });
  }

  loadStatus().then(function (ok) {
    if (!ok) return;
    loadGroups()
      .catch(function () { /* picker may still work after packages load */ })
      .finally(function () {
        loadPackages();
      });
  });
  updateBulkActionButtonState();
})();
</script>
