<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Channel Patch",
    scopedSuffix: "Channel Patch",
    singleFallbackTitle: "Agency Channel Patch"
  }) %>

  <div class="card createFormCard">
    <div class="row cp-formHeader createFormHeader" style="justify-content: space-between; align-items: center;">
      <h2 style="margin: 0;" id="cpFormTitle">Create New Patch</h2>
      <div class="row" style="gap:8px;">
        <button class="btn" id="cpCancelEditBtn" type="button" style="display:none;">Cancel Edit</button>
      </div>
    </div>

    <div class="createForm">
    <div class="cp-nameTypeRow">
      <label class="cp-field">
        Name
        <input id="cpName" type="text" placeholder="e.g. Multi-Agency Patch, Task Force Patch, etc..." maxlength="120" />
      </label>
      <label class="cp-field">
        Patch Type
        <select id="cpMode" aria-label="Patch Type">
          <option value="bidirectional" selected>Bi-Directional Patch</option>
          <option value="unidirectional">Uni-Directional Patch</option>
        </select>
      </label>
    </div>

    <div id="cpBiSection">
      <label>
        Channels
        <div class="row cp-channelToolbar">
          <input id="cpChannelSearch" type="search" placeholder="Search channels..." />
          <button class="btn" type="button" id="cpSelectAllBtn">Select All</button>
          <button class="btn" type="button" id="cpClearAllBtn">Clear All</button>
        </div>

        <div id="cpChannelsBox" class="groupsBox">
          <div id="cpChannelsInner" class="groupsInner">
            <div class="msg">Loading channels…</div>
          </div>
        </div>
      </label>
    </div>

    <div id="cpUniSection" style="display:none;">
      <div class="cp-uniLayout">
        <div class="cp-uniPane">
          <div class="cp-uniPaneHeader">
            <span class="cp-uniPaneTitle">Group A</span>
            <div class="row cp-uniPaneActions">
              <button class="btn" type="button" id="cpLeftSelectAllBtn">Select All</button>
              <button class="btn" type="button" id="cpLeftClearBtn">Clear</button>
            </div>
          </div>
          <div class="cp-uniPaneSearch">
            <input id="cpGroupASearch" type="search" placeholder="Search Group A…" aria-label="Search Group A" />
          </div>
          <div id="cpLeftBox" class="groupsBox cp-uniBox" data-side="a">
            <div id="cpLeftInner" class="groupsInner cp-uniInner">
              <div class="msg">Loading channels…</div>
            </div>
          </div>
        </div>

        <div class="cp-uniArrowCol">
          <button
            type="button"
            class="btn cp-dirBtn"
            id="cpDirBtn"
            aria-label="Patch direction: Group A to Group B"
            title="Click to reverse direction"
          >→</button>
          <div class="cp-dirHint" id="cpDirHint">Group A → Group B</div>
        </div>

        <div class="cp-uniPane">
          <div class="cp-uniPaneHeader">
            <span class="cp-uniPaneTitle">Group B</span>
            <div class="row cp-uniPaneActions">
              <button class="btn" type="button" id="cpRightSelectAllBtn">Select All</button>
              <button class="btn" type="button" id="cpRightClearBtn">Clear</button>
            </div>
          </div>
          <div class="cp-uniPaneSearch">
            <input id="cpGroupBSearch" type="search" placeholder="Search Group B…" aria-label="Search Group B" />
          </div>
          <div id="cpRightBox" class="groupsBox cp-uniBox" data-side="b">
            <div id="cpRightInner" class="groupsInner cp-uniInner">
              <div class="msg">Loading channels…</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row cp-formFooter createActionsRow">
      <div id="cpFormMsg" class="msg"></div>
      <div class="cp-enableCreate" id="cpEnableCreateRow">
        <span>Enable Patch Upon Creation</span>
        <button
          type="button"
          id="cpCreateEnabled"
          class="settings-toggle is-on"
          aria-pressed="true"
          aria-label="Enable Patch Upon Creation"
        ></button>
      </div>
      <button class="btn success" type="button" id="cpSubmitBtn">Create New Patch</button>
    </div>
    </div>
  </div>

  <div class="card">
    <div class="row" style="justify-content: space-between; align-items:center;">
      <h2 style="margin:0;">Existing Patches</h2>
    </div>
    <div id="cpPatchBoard" class="cp-board">
      <div class="msg">Loading patches…</div>
    </div>
  </div>
</main>

<style>
  .cp-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .cp-field input,
  .cp-field select {
    width: 100%;
    box-sizing: border-box;
  }
  .cp-field select {
    height: 38px;
    padding: 0 10px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: inherit;
  }

  .cp-nameTypeRow {
    display: flex;
    gap: 14px;
    align-items: flex-end;
    flex-wrap: wrap;
    width: 100%;
  }
  .cp-nameTypeRow .cp-field {
    flex: 1 1 220px;
    min-width: 0;
  }
  .cp-nameTypeRow .cp-field input,
  .cp-nameTypeRow .cp-field select {
    width: 100%;
    max-width: none;
  }

  .cp-channelToolbar {
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .cp-channelToolbar input[type="search"] {
    flex: 1 1 160px;
    min-width: 0;
    width: auto;
    box-sizing: border-box;
  }

  .groupsBox {
    margin-top: 10px;
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 12px;
    padding: 10px;
    max-height: 320px;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .groupsInner {
    column-width: 280px;
    column-gap: 14px;
    column-count: 4;
  }
  .groupItem {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 10px;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
  }
  .groupItem span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cp-uniLayout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 12px;
    align-items: stretch;
    width: 100%;
  }
  .cp-uniPane {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .cp-uniPaneHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cp-uniPaneActions {
    gap: 6px;
    flex-wrap: wrap;
  }
  .cp-uniPaneTitle {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .cp-uniPaneSearch {
    margin-top: 8px;
  }
  .cp-uniPaneSearch input[type="search"] {
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }
  .cp-uniBox {
    margin-top: 8px;
    flex: 1;
    max-height: 360px;
  }
  .cp-uniInner {
    column-count: 2;
    column-width: 160px;
  }
  .cp-uniArrowCol {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-top: 36px;
    align-self: center;
  }
  .cp-dirBtn {
    min-width: 52px;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1;
    padding: 10px 14px;
  }
  .cp-dirHint {
    font-size: 0.78rem;
    color: var(--muted, #8b93a7);
    text-align: center;
    max-width: 7.5rem;
    line-height: 1.25;
  }

  .cp-formFooter {
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cp-enableCreate {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    user-select: none;
    font-size: 0.92rem;
  }

  .cp-board {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cp-patch {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 16px;
    min-width: 0;
    overflow: hidden;
  }
  .cp-patch.is-on {
    border-color: color-mix(in srgb, #22c55e 55%, var(--line));
    background: color-mix(in srgb, #22c55e 16%, var(--panel));
  }
  .cp-patch.is-off {
    border-color: color-mix(in srgb, #ef4444 50%, var(--line));
    background: color-mix(in srgb, #ef4444 14%, var(--panel));
  }
  .cp-patchTop {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cp-patchTitle {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .cp-patchMode {
    display: inline-block;
    margin-top: 4px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted, #8b93a7);
  }
  .cp-patchActions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .cp-enableRow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
  }
  .cp-danger {
    background: transparent;
    border: 1px solid color-mix(in srgb, #e35d5d 55%, var(--line));
    color: #e35d5d;
  }
  .cp-danger:hover {
    background: color-mix(in srgb, #e35d5d 12%, transparent);
  }

  .cp-topology {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .cp-dataSyncs {
    margin-top: 10px;
    font-size: 0.86rem;
    line-height: 1.4;
  }
  .cp-dataSyncsLabel {
    font-weight: 700;
    color: #c2410c;
  }
  .cp-dataSyncsList {
    margin-top: 2px;
    color: var(--muted, #8b93a7);
  }
  .cp-topoSide {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .cp-topoArrow {
    font-size: 1.2rem;
    font-weight: 700;
    padding: 0 4px;
    color: var(--muted, #8b93a7);
  }
  .cp-node {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 65%, transparent);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cp-empty {
    padding: 18px 4px;
    color: var(--muted, #8b93a7);
  }

  /* Tablet / mobile: stacked layout, no horizontal scroll */
  @media (max-width: 990px) {
    .cp-formHeader {
      flex-wrap: wrap;
      align-items: stretch !important;
      gap: 10px;
    }
    .cp-formHeader h2 {
      flex: 1 1 100%;
    }
    .cp-formHeader .row,
    .cp-formHeader .btn {
      width: 100% !important;
    }

    .cp-nameTypeRow {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .cp-nameTypeRow .cp-field {
      flex: 1 1 auto;
      width: 100%;
    }

    .cp-channelToolbar {
      align-items: stretch !important;
    }
    .cp-channelToolbar input[type="search"] {
      flex: 1 1 100%;
      width: 100%;
    }
    .cp-channelToolbar .btn {
      flex: 1 1 calc(50% - 10px);
      width: 100% !important;
      min-width: 0;
      text-align: center;
    }

    .cp-uniLayout {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .cp-uniArrowCol {
      flex-direction: row;
      flex-wrap: wrap;
      padding-top: 0;
      justify-content: center;
      gap: 10px;
    }
    .cp-dirHint {
      max-width: none;
      white-space: nowrap;
    }
    .cp-uniPaneHeader {
      align-items: stretch;
    }
    .cp-uniPaneActions {
      width: 100%;
    }
    .cp-uniPaneActions .btn {
      flex: 1 1 calc(50% - 6px);
      min-width: 0;
      text-align: center;
    }
    .cp-uniInner {
      column-count: 2;
      column-width: auto;
    }

    .groupsInner {
      column-count: 2;
      column-width: auto;
    }
    .groupItem {
      white-space: normal;
    }
    .groupItem span {
      overflow: visible;
      text-overflow: unset;
      word-break: break-word;
    }

    .cp-formFooter {
      flex-direction: column;
      align-items: stretch !important;
      justify-content: flex-start !important;
    }
    .cp-formFooter .msg {
      width: 100%;
    }
    .cp-enableCreate {
      width: 100%;
      justify-content: space-between;
    }
    .cp-formFooter .btn {
      width: 100% !important;
    }

    .cp-patchTop {
      flex-direction: column;
      align-items: stretch;
    }
    .cp-patchTitle {
      word-break: break-word;
    }
    .cp-patchActions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      gap: 8px;
    }
    .cp-enableRow {
      grid-column: 1 / -1;
      justify-content: space-between;
    }
    .cp-patchActions .btn {
      width: 100% !important;
      max-width: 100%;
      min-width: 0;
      margin: 0;
      box-sizing: border-box;
      text-align: center;
    }
    .cp-topology {
      flex-direction: column;
      align-items: stretch;
    }
    .cp-topoArrow {
      text-align: center;
      padding: 4px 0;
    }
    .cp-node {
      max-width: 100%;
      white-space: normal;
      word-break: break-word;
    }
  }

  @media (max-width: 560px) {
    .groupsInner,
    .cp-uniInner {
      column-count: 1;
    }
    .cp-channelToolbar .btn,
    .cp-uniPaneActions .btn {
      flex: 1 1 100%;
    }
    .cp-dirBtn {
      min-width: 48px;
      width: auto;
    }
  }

  @media (max-width: 400px) {
    .cp-patchActions {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
(function () {
  const formTitle = document.getElementById("cpFormTitle");
  const cancelEditBtn = document.getElementById("cpCancelEditBtn");
  const biSection = document.getElementById("cpBiSection");
  const uniSection = document.getElementById("cpUniSection");
  const modeSelect = document.getElementById("cpMode");
  const channelsBox = document.getElementById("cpChannelsBox");
  const channelsInner = document.getElementById("cpChannelsInner");
  const channelSearch = document.getElementById("cpChannelSearch");
  const selectAllBtn = document.getElementById("cpSelectAllBtn");
  const clearAllBtn = document.getElementById("cpClearAllBtn");
  const groupASearch = document.getElementById("cpGroupASearch");
  const groupBSearch = document.getElementById("cpGroupBSearch");
  const leftBox = document.getElementById("cpLeftBox");
  const leftInner = document.getElementById("cpLeftInner");
  const rightBox = document.getElementById("cpRightBox");
  const rightInner = document.getElementById("cpRightInner");
  const leftSelectAllBtn = document.getElementById("cpLeftSelectAllBtn");
  const leftClearBtn = document.getElementById("cpLeftClearBtn");
  const rightSelectAllBtn = document.getElementById("cpRightSelectAllBtn");
  const rightClearBtn = document.getElementById("cpRightClearBtn");
  const dirBtn = document.getElementById("cpDirBtn");
  const dirHint = document.getElementById("cpDirHint");
  const nameInput = document.getElementById("cpName");
  const submitBtn = document.getElementById("cpSubmitBtn");
  const createEnabledBtn = document.getElementById("cpCreateEnabled");
  const enableCreateRow = document.getElementById("cpEnableCreateRow");
  const formMsg = document.getElementById("cpFormMsg");
  const board = document.getElementById("cpPatchBoard");

  /** @type {{ name: string, displayName: string, baseKey: string }[]} */
  let channels = [];
  /** @type {object[]} */
  let patchesCache = [];
  /** Persist checked names across filter re-renders */
  const selectedNames = new Set();
  const selectedLeft = new Set();
  const selectedRight = new Set();
  /** @type {"ltr"|"rtl"} */
  let uniDirection = "ltr";
  /** @type {string|null} */
  let editingId = null;
  let isAgencyScoped = false;

  function esc(s) {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function displayFor(nameOrKey) {
    const raw = String(nameOrKey || "").trim();
    const hit = channels.find(
      (c) => c.name === raw || c.baseKey === raw.toLowerCase() || c.displayName === raw
    );
    return hit ? hit.displayName : raw.replace(/^tak_/i, "");
  }

  function resolveCatalogName(g) {
    const hit = channels.find(
      (c) =>
        c.name === g ||
        c.baseKey === String(g).toLowerCase() ||
        c.displayName === g
    );
    return hit ? hit.name : g;
  }

  function isToggleOn(btn) {
    return !!(btn && btn.classList.contains("is-on"));
  }

  function setToggle(btn, on) {
    if (!btn) return;
    btn.classList.toggle("is-on", !!on);
    btn.classList.toggle("is-off", !on);
    btn.setAttribute("aria-pressed", on ? "true" : "false");
  }

  function currentMode() {
    return modeSelect.value === "unidirectional"
      ? "unidirectional"
      : "bidirectional";
  }

  function isUni() {
    return currentMode() === "unidirectional";
  }

  function filteredChannels(searchEl) {
    const q = String((searchEl || channelSearch).value || "").trim().toLowerCase();
    return channels.filter((c) => {
      if (!q) return true;
      return (
        c.displayName.toLowerCase().includes(q) ||
        c.name.toLowerCase().includes(q)
      );
    });
  }

  function updateDirUi() {
    const isLtr = uniDirection !== "rtl";
    const stacked =
      typeof window.matchMedia === "function" &&
      window.matchMedia("(max-width: 990px)").matches;
    if (stacked) {
      dirBtn.textContent = isLtr ? "↓" : "↑";
    } else {
      dirBtn.textContent = isLtr ? "→" : "←";
    }
    dirBtn.setAttribute(
      "aria-label",
      isLtr
        ? "Patch direction: Group A to Group B"
        : "Patch direction: Group B to Group A"
    );
    dirHint.textContent = isLtr ? "Group A → Group B" : "Group B → Group A";
  }

  function syncModeUi() {
    const uni = isUni();
    biSection.style.display = uni ? "none" : "";
    uniSection.style.display = uni ? "" : "none";
  }

  function renderCheckboxList(inner, list, selectedSet, emptyMsg) {
    if (!list.length) {
      inner.innerHTML = `<div class="msg">${esc(emptyMsg)}</div>`;
      return;
    }
    inner.innerHTML = list
      .map((c) => {
        const checked = selectedSet.has(c.name) ? "checked" : "";
        return `<label class="groupItem"><input type="checkbox" value="${esc(
          c.name
        )}" ${checked} /><span>${esc(c.displayName)}</span></label>`;
      })
      .join("");
  }

  function renderChannelsBox() {
    const list = filteredChannels(channelSearch);
    renderCheckboxList(
      channelsInner,
      list,
      selectedNames,
      isAgencyScoped
        ? "No agency channels in your scope."
        : "No matching channels."
    );
  }

  function renderUniBoxes() {
    const empty = isAgencyScoped
      ? "No agency channels in your scope."
      : "No matching channels.";
    renderCheckboxList(
      leftInner,
      filteredChannels(groupASearch),
      selectedLeft,
      empty
    );
    renderCheckboxList(
      rightInner,
      filteredChannels(groupBSearch),
      selectedRight,
      empty
    );
  }

  function renderChannelUi() {
    if (isUni()) renderUniBoxes();
    else renderChannelsBox();
  }

  function setMsg(text, isError) {
    formMsg.textContent = text || "";
    formMsg.style.color = isError ? "#e35d5d" : "";
  }

  function setCreateMode() {
    editingId = null;
    formTitle.textContent = "Create New Patch";
    submitBtn.textContent = "Create New Patch";
    cancelEditBtn.style.display = "none";
    enableCreateRow.style.display = "";
    setToggle(createEnabledBtn, true);
    nameInput.value = "";
    modeSelect.value = "bidirectional";
    channelSearch.value = "";
    groupASearch.value = "";
    groupBSearch.value = "";
    selectedNames.clear();
    selectedLeft.clear();
    selectedRight.clear();
    uniDirection = "ltr";
    updateDirUi();
    syncModeUi();
    renderChannelUi();
    setMsg("");
  }

  function setEditMode(id) {
    const patch = patchesCache.find((p) => String(p.id) === String(id));
    if (!patch) return;

    editingId = String(patch.id);
    formTitle.textContent = "Edit Patch";
    submitBtn.textContent = "Save Changes";
    cancelEditBtn.style.display = "inline-block";
    enableCreateRow.style.display = "none";
    setMsg("");

    nameInput.value = patch.name || "";
    channelSearch.value = "";
    groupASearch.value = "";
    groupBSearch.value = "";
    selectedNames.clear();
    selectedLeft.clear();
    selectedRight.clear();

    const mode =
      patch.mode === "unidirectional" ? "unidirectional" : "bidirectional";
    modeSelect.value = mode;

    if (mode === "unidirectional") {
      uniDirection = patch.direction === "rtl" ? "rtl" : "ltr";
      for (const g of patch.leftGroups || []) {
        selectedLeft.add(resolveCatalogName(g));
      }
      for (const g of patch.rightGroups || []) {
        selectedRight.add(resolveCatalogName(g));
      }
    } else {
      uniDirection = "ltr";
      for (const g of patch.groups || []) {
        selectedNames.add(resolveCatalogName(g));
      }
    }

    updateDirUi();
    syncModeUi();
    renderChannelUi();
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  async function api(path, opts) {
    const res = await fetch(path, {
      headers: { Accept: "application/json", "Content-Type": "application/json" },
      ...opts,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      const err = new Error(data.error || data.message || res.statusText || "Request failed");
      err.status = res.status;
      throw err;
    }
    return data;
  }

  function nodesHtml(groups) {
    return (Array.isArray(groups) ? groups : [])
      .map((g) => `<span class="cp-node">${esc(displayFor(g))}</span>`)
      .join("");
  }

  function topologyHtml(p) {
    if (p.mode === "unidirectional") {
      const left = Array.isArray(p.leftGroups) ? p.leftGroups : [];
      const right = Array.isArray(p.rightGroups) ? p.rightGroups : [];
      const arrow = p.direction === "rtl" ? "←" : "→";
      return `
        <div class="cp-topoSide">${nodesHtml(left)}</div>
        <span class="cp-topoArrow" aria-hidden="true">${arrow}</span>
        <div class="cp-topoSide">${nodesHtml(right)}</div>`;
    }
    return nodesHtml(p.groups);
  }

  function affectedDataSyncNames(p) {
    const applied = p && p.dataSyncApplied && typeof p.dataSyncApplied === "object"
      ? p.dataSyncApplied
      : {};
    return Object.keys(applied)
      .map((n) => String(n || "").trim())
      .filter(Boolean)
      .sort((a, b) => a.localeCompare(b, undefined, { sensitivity: "base" }));
  }

  function dataSyncsHtml(p) {
    const names = affectedDataSyncNames(p);
    if (!names.length) return "";
    return `
      <div class="cp-dataSyncs">
        <div class="cp-dataSyncsLabel">Affected Data Sync${names.length === 1 ? "" : "s"}</div>
        <div class="cp-dataSyncsList">${esc(names.join(", "))}</div>
      </div>`;
  }

  function renderBoard(patches) {
    patchesCache = Array.isArray(patches) ? patches : [];
    if (!patchesCache.length) {
      board.innerHTML = isAgencyScoped
        ? '<div class="cp-empty">No patches in your agency scope.</div>'
        : '<div class="cp-empty">No patches yet.</div>';
      return;
    }

    board.innerHTML = patchesCache
      .map((p) => {
        const modeLabel =
          p.mode === "unidirectional"
            ? "Uni-Directional"
            : "Bi-Directional";
        return `
          <article class="cp-patch ${p.enabled ? "is-on" : "is-off"}" data-id="${esc(p.id)}">
            <div class="cp-patchTop">
              <div>
                <h3 class="cp-patchTitle">${esc(p.name)}</h3>
                <span class="cp-patchMode">${esc(modeLabel)}</span>
              </div>
              <div class="cp-patchActions cardActionsRow">
                <div class="cp-enableRow">
                  <button
                    type="button"
                    class="settings-toggle ${p.enabled ? "is-on" : "is-off"} cp-enableToggle"
                    aria-pressed="${p.enabled ? "true" : "false"}"
                    aria-label="Enable ${esc(p.name)}"
                  ></button>
                </div>
                <button type="button" class="btn cp-editBtn">Edit</button>
                <button type="button" class="btn cp-danger cp-deleteBtn">Delete</button>
              </div>
            </div>
            <div class="cp-topology">${topologyHtml(p)}</div>
            ${dataSyncsHtml(p)}
          </article>`;
      })
      .join("");
  }

  async function loadMeta() {
    const meta = await api("/api/channel-patch/meta");
    isAgencyScoped = !!meta.isAgencyAdmin && !meta.isGlobalAdmin;
    channels = Array.isArray(meta.channels) ? meta.channels : [];
    channels.sort((a, b) =>
      String(a.displayName || "").localeCompare(String(b.displayName || ""), undefined, {
        sensitivity: "base",
      })
    );
    renderChannelUi();
  }

  async function loadPatches() {
    const data = await api("/api/channel-patch");
    renderBoard(Array.isArray(data.patches) ? data.patches : []);
  }

  async function refreshAll() {
    await loadMeta();
    await loadPatches();
  }

  modeSelect.addEventListener("change", () => {
    syncModeUi();
    renderChannelUi();
  });

  channelSearch.addEventListener("input", () => {
    renderChannelsBox();
  });

  groupASearch.addEventListener("input", () => {
    renderCheckboxList(
      leftInner,
      filteredChannels(groupASearch),
      selectedLeft,
      isAgencyScoped
        ? "No agency channels in your scope."
        : "No matching channels."
    );
  });

  groupBSearch.addEventListener("input", () => {
    renderCheckboxList(
      rightInner,
      filteredChannels(groupBSearch),
      selectedRight,
      isAgencyScoped
        ? "No agency channels in your scope."
        : "No matching channels."
    );
  });

  channelsBox.addEventListener("change", (e) => {
    const cb = e.target && e.target.matches('input[type="checkbox"]') ? e.target : null;
    if (!cb) return;
    if (cb.checked) selectedNames.add(cb.value);
    else selectedNames.delete(cb.value);
  });

  function onUniSideChange(side, e) {
    const cb = e.target && e.target.matches('input[type="checkbox"]') ? e.target : null;
    if (!cb) return;
    const mine = side === "a" ? selectedLeft : selectedRight;
    const other = side === "a" ? selectedRight : selectedLeft;
    if (cb.checked) {
      mine.add(cb.value);
      other.delete(cb.value);
    } else {
      mine.delete(cb.value);
    }
    renderUniBoxes();
  }

  leftBox.addEventListener("change", (e) => onUniSideChange("a", e));
  rightBox.addEventListener("change", (e) => onUniSideChange("b", e));

  selectAllBtn.addEventListener("click", () => {
    for (const c of filteredChannels(channelSearch)) selectedNames.add(c.name);
    renderChannelsBox();
  });

  clearAllBtn.addEventListener("click", () => {
    for (const c of filteredChannels(channelSearch)) selectedNames.delete(c.name);
    renderChannelsBox();
  });

  leftSelectAllBtn.addEventListener("click", () => {
    for (const c of filteredChannels(groupASearch)) {
      selectedLeft.add(c.name);
      selectedRight.delete(c.name);
    }
    renderUniBoxes();
  });

  leftClearBtn.addEventListener("click", () => {
    for (const c of filteredChannels(groupASearch)) selectedLeft.delete(c.name);
    renderUniBoxes();
  });

  rightSelectAllBtn.addEventListener("click", () => {
    for (const c of filteredChannels(groupBSearch)) {
      selectedRight.add(c.name);
      selectedLeft.delete(c.name);
    }
    renderUniBoxes();
  });

  rightClearBtn.addEventListener("click", () => {
    for (const c of filteredChannels(groupBSearch)) selectedRight.delete(c.name);
    renderUniBoxes();
  });

  dirBtn.addEventListener("click", () => {
    uniDirection = uniDirection === "ltr" ? "rtl" : "ltr";
    updateDirUi();
  });

  window.addEventListener("resize", () => {
    if (isUni()) updateDirUi();
  });

  createEnabledBtn.addEventListener("click", () => {
    setToggle(createEnabledBtn, !isToggleOn(createEnabledBtn));
  });

  cancelEditBtn.addEventListener("click", () => setCreateMode());

  submitBtn.addEventListener("click", async () => {
    setMsg("");
    const name = String(nameInput.value || "").trim();
    const mode = currentMode();
    let body;

    if (mode === "unidirectional") {
      const leftGroups = Array.from(selectedLeft);
      const rightGroups = Array.from(selectedRight);
      if (!leftGroups.length || !rightGroups.length) {
        setMsg("Select at least one channel in Group A and Group B.", true);
        return;
      }
      body = {
        name: name || undefined,
        mode: "unidirectional",
        leftGroups,
        rightGroups,
        direction: uniDirection,
      };
    } else {
      const groups = Array.from(selectedNames);
      if (groups.length < 2) {
        setMsg("Select at least two channels.", true);
        return;
      }
      body = {
        name: name || undefined,
        mode: "bidirectional",
        groups,
      };
    }

    submitBtn.disabled = true;
    const isEdit = !!editingId;
    try {
      if (isEdit) {
        await api("/api/channel-patch/" + encodeURIComponent(editingId), {
          method: "PATCH",
          body: JSON.stringify({
            name,
            ...body,
          }),
        });
        setCreateMode();
        setMsg("Patch updated.");
      } else {
        await api("/api/channel-patch", {
          method: "POST",
          body: JSON.stringify({
            ...body,
            enabled: isToggleOn(createEnabledBtn),
          }),
        });
        setCreateMode();
        setMsg("Patch created.");
      }
      await loadPatches();
    } catch (err) {
      setMsg(err.message || (isEdit ? "Update failed" : "Create failed"), true);
    } finally {
      submitBtn.disabled = false;
    }
  });

  board.addEventListener("click", async (e) => {
    const toggle = e.target.closest(".cp-enableToggle");
    if (toggle) {
      const card = toggle.closest(".cp-patch");
      if (!card) return;
      const id = card.getAttribute("data-id");
      const next = !isToggleOn(toggle);
      setToggle(toggle, next);
      card.classList.toggle("is-on", next);
      card.classList.toggle("is-off", !next);
      toggle.disabled = true;
      try {
        await api("/api/channel-patch/" + encodeURIComponent(id), {
          method: "PATCH",
          body: JSON.stringify({ enabled: next }),
        });
        await loadPatches();
      } catch (err) {
        setToggle(toggle, !next);
        card.classList.toggle("is-on", !next);
        card.classList.toggle("is-off", next);
        alert(err.message || "Update failed");
      } finally {
        toggle.disabled = false;
      }
      return;
    }

    const editBtn = e.target.closest(".cp-editBtn");
    if (editBtn) {
      const card = editBtn.closest(".cp-patch");
      if (!card) return;
      setEditMode(card.getAttribute("data-id"));
      return;
    }

    const btn = e.target.closest(".cp-deleteBtn");
    if (!btn) return;
    const card = btn.closest(".cp-patch");
    if (!card) return;
    const id = card.getAttribute("data-id");
    const title = card.querySelector(".cp-patchTitle")?.textContent || "this patch";
    if (!confirm(`Delete ${title}?`)) return;
    btn.disabled = true;
    try {
      await api("/api/channel-patch/" + encodeURIComponent(id), { method: "DELETE" });
      if (editingId && String(editingId) === String(id)) setCreateMode();
      await loadPatches();
    } catch (err) {
      alert(err.message || "Delete failed");
      btn.disabled = false;
    }
  });

  updateDirUi();
  syncModeUi();

  refreshAll().catch((err) => {
    setMsg(err.message || "Failed to load", true);
    board.innerHTML = `<div class="msg" style="color:#e35d5d;">${esc(
      err.message || "Failed to load patches"
    )}</div>`;
  });
})();
</script>
